# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=creditguard
DB_USER=creditguard
DB_PASSWORD=changeme
DB_SCHEMA=public

MLFLOW_TRACKING_URI=http://localhost:5000
API_KEY=changeme
ENV=dev
SEED=42

MODEL_DIR=models/artifacts
REPORTS_DIR=reports
DATA_DIR=data

# Phase 8 (API)
RATE_LIMIT_RPM=100
CORS_ORIGINS=http://localhost:8501

# Phase 10 (Monitoring)
MONITORING_INTERVAL_MINUTES=60
# Optional: a webhook URL (e.g. Slack incoming webhook) alerts.py POSTs to.
# Leave unset to use only the console + log-file alert sinks.
ALERT_WEBHOOK_URL=

# Phase 10 (API container) -- used by docker-compose.yml's api/dashboard
# services; not read by creditguard.config.Settings directly.
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
UVICORN_WORKERS=1
API_BASE_URL=http://api:8000
